# Copy this file to .env and fill in the values. Never commit .env.

# Long random string. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# True for local development, False in production.
DEBUG=True

# Comma-separated host names.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated full origins (with scheme), e.g. https://what-now.vercel.app
CSRF_TRUSTED_ORIGINS=

# Leave empty to use local SQLite. For Supabase use the PostgreSQL connection string, e.g.
# postgresql://USER:PASSWORD@HOST:PORT/postgres
DATABASE_URL=
